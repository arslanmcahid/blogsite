# deploy/.env olarak kopyala ve doldur. Bu dosya sunucuda kalır, Git'e eklenmez.

# Blogun alan adı (DNS A kaydı sunucunun IP'sine bakmalı)
DOMAIN=yazdedik.com

# Güçlü, rastgele değerler üret:  openssl rand -base64 48
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Caddy'nin bağlı olduğu Docker ağının adı:  docker network ls
PROXY_NETWORK=travel-blog_default

# Düşük RAM için 2 yeterli (varsayılan)
GUNICORN_WORKERS=2
